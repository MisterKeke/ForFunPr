<UserControl x:Class="Something.Desktop.Views.BookmarksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="980">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="1120" Margin="0,0,24,24" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource PageTitleStyle}" />
                    <TextBlock Margin="0,7,0,0" MaxWidth="620" HorizontalAlignment="Left"
                               Text="{Binding Subtitle}" Style="{DynamicResource PageSubtitleStyle}" />
                </StackPanel>

                <Border Grid.Row="1" Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="135" />
                                <ColumnDefinition Width="165" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Margin="0,0,10,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search titles, URLs, descriptions, and tags" />
                            <ComboBox Grid.Column="1" Margin="0,0,10,0"
                                      SelectedValue="{Binding SelectedStatus}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="All states" Tag="All" />
                                <ComboBoxItem Content="Unread" Tag="Unread" />
                                <ComboBoxItem Content="Read" Tag="Read" />
                            </ComboBox>
                            <ComboBox Grid.Column="2" Margin="0,0,10,0"
                                      ItemsSource="{Binding TagOptions}" SelectedItem="{Binding SelectedTag}" />
                            <Button Grid.Column="3" Command="{Binding NewBookmarkCommand}"
                                    Content="Add bookmark" Style="{DynamicResource PrimaryButtonStyle}" />
                        </Grid>

                        <Border Margin="0,14,0,0" Padding="11" Background="#20FF6B8A"
                                BorderBrush="#70FF6B8A" BorderThickness="1" CornerRadius="8"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                                       Text="{Binding ErrorMessage}" />
                        </Border>

                        <TextBlock Margin="2,14,0,10" FontSize="12"
                                   Foreground="{DynamicResource TextDimBrush}" Text="{Binding TotalLabel}" />

                        <Grid>
                            <ItemsControl ItemsSource="{Binding Bookmarks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,11" Padding="15"
                                                Background="{DynamicResource PanelAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,18,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Margin="0,0,9,0" Padding="7,3" Background="#247C8CFF"
                                                                CornerRadius="9">
                                                            <TextBlock FontSize="10" Foreground="{DynamicResource AccentHoverBrush}"
                                                                       Text="{Binding ReadStateText}" />
                                                        </Border>
                                                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource NeonCyanBrush}"
                                                               FontSize="12" Text="{Binding Host}" />
                                                    <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextDimBrush}"
                                                               FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding Url}" />
                                                    <TextBlock Margin="0,9,0,0" Foreground="{DynamicResource TextDimBrush}"
                                                               TextWrapping="Wrap" Text="{Binding Description}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Description}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ItemsControl Margin="0,9,0,0" ItemsSource="{Binding Tags}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,6,4" Padding="7,3"
                                                                        BorderBrush="#687C8CFF" BorderThickness="1" CornerRadius="10">
                                                                    <TextBlock FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                                                               Text="{Binding}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Margin="0,8,0,0" FontSize="10"
                                                               Foreground="{DynamicResource TextDimBrush}"
                                                               Text="{Binding CreatedAt, StringFormat=Saved {0:g}}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" MinWidth="110">
                                                    <Button Margin="0,0,0,7" Padding="10,6"
                                                            Command="{Binding DataContext.OpenBookmarkCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            CommandParameter="{Binding}" Content="Open"
                                                            Style="{DynamicResource PrimaryButtonStyle}" />
                                                    <Button Margin="0,0,0,7" Padding="10,6"
                                                            Command="{Binding DataContext.ToggleReadCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            CommandParameter="{Binding}" Content="{Binding ReadActionText}"
                                                            Style="{DynamicResource SecondaryButtonStyle}" />
                                                    <Button Margin="0,0,0,7" Padding="10,6"
                                                            Command="{Binding DataContext.EditBookmarkCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            CommandParameter="{Binding}" Content="Edit"
                                                            Style="{DynamicResource SecondaryButtonStyle}" />
                                                    <Button Padding="10,6"
                                                            Command="{Binding DataContext.DeleteBookmarkCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            CommandParameter="{Binding}" Content="Delete"
                                                            Style="{DynamicResource SecondaryButtonStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="8,42" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextDimBrush}"
                                       Text="No bookmarks match these filters."
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>

                        <Button Margin="0,4,0,0" Command="{Binding LoadMoreCommand}"
                                Content="Load more" Style="{DynamicResource SecondaryButtonStyle}"
                                Visibility="{Binding CanLoadMore, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Panel.ZIndex="40" Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="620" MaxHeight="680" Margin="24" Style="{DynamicResource DialogCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorHeading}" Style="{DynamicResource SectionTitleStyle}" />
                        <TextBlock Margin="0,16,0,5" Foreground="{DynamicResource TextDimBrush}" Text="HTTP or HTTPS URL" />
                        <TextBox Text="{Binding DraftUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,12,0,5" Foreground="{DynamicResource TextDimBrush}" Text="Title" />
                        <TextBox Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,12,0,5" Foreground="{DynamicResource TextDimBrush}" Text="Description" />
                        <TextBox MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap"
                                 Text="{Binding DraftDescription, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,12,0,5" Foreground="{DynamicResource TextDimBrush}"
                                   Text="Tags (comma-separated)" />
                        <TextBox Text="{Binding DraftTags, UpdateSourceTrigger=PropertyChanged}" />

                        <Border Margin="0,14,0,0" Padding="11" Background="#20FF6B8A"
                                BorderBrush="#70FF6B8A" BorderThickness="1" CornerRadius="8"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                                           Text="{Binding ErrorMessage}" />
                                <Button Grid.Column="1" Margin="12,0,0,0" Padding="9,5"
                                        Command="{Binding ReloadEditorCommand}" Content="Reload"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        Visibility="{Binding HasConflict, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <StackPanel Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Margin="0,0,10,0" Command="{Binding CloseEditorCommand}"
                                    Content="Cancel" Style="{DynamicResource SecondaryButtonStyle}" />
                            <Button MinWidth="130" Command="{Binding SaveBookmarkCommand}"
                                    Content="Save bookmark" Style="{DynamicResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <Border Panel.ZIndex="60" Background="#9811131D"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressBar Width="190" Height="4" IsIndeterminate="True"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
