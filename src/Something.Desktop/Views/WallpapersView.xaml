<UserControl x:Class="Something.Desktop.Views.WallpapersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="950">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1120" Margin="0,0,24,24" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource PageTitleStyle}" />
                    <TextBlock Margin="0,7,0,0" Text="{Binding Subtitle}"
                               Style="{DynamicResource PageSubtitleStyle}" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Content="Import wallpaper" Command="{Binding ImportCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}" />
            </Grid>

            <Border Grid.Row="1" Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <Border Margin="0,0,0,14" Padding="10" Background="#20FF6B8A"
                            BorderBrush="#70FF6B8A" BorderThickness="1" CornerRadius="8"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Foreground="{DynamicResource ErrorBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Margin="0,20" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextDimBrush}" Text="No wallpapers are available."
                               Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ItemsControl ItemsSource="{Binding Choices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="250" Margin="0,0,12,12" Padding="10"
                                        Background="{DynamicResource PanelAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="10">
                                    <StackPanel>
                                        <Button Height="135" Padding="0" Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}" Style="{DynamicResource SecondaryButtonStyle}">
                                            <Grid ClipToBounds="True">
                                                <Border Background="#FF191B29" />
                                                <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                                <Border Background="#30000000" />
                                                <Border Width="30" Height="30" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Background="{DynamicResource AccentBrush}" CornerRadius="15"
                                                        Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="#FF071018" FontWeight="Bold" Text="&#xE73E;"
                                                               FontFamily="{DynamicResource IconFontFamily}" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <Grid Margin="2,10,2,0">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                                                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextDimBrush}"
                                                           Text="{Binding Description}" />
                                            </StackPanel>
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="Delete"
                                                    Foreground="{DynamicResource ErrorBrush}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}" Style="{DynamicResource SecondaryButtonStyle}"
                                                    Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
