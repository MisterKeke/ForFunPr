<UserControl x:Class="Something.Desktop.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enums="clr-namespace:Something.Domain.Enums;assembly=Something.Domain"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="950">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
            <Grid x:Name="TasksViewport" Margin="0,0,24,24">
            <Grid Width="{Binding ActualWidth, ElementName=TasksViewport}"
                  MaxWidth="1120" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource PageTitleStyle}" />
                    <TextBlock Margin="0,7,0,0" MaxWidth="620" HorizontalAlignment="Left"
                               Text="{Binding Subtitle}" Style="{DynamicResource PageSubtitleStyle}" />
                </StackPanel>

                <TabControl Grid.Row="1"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextBrush}">
                    <TabItem Header="Tasks">
                        <Border Margin="0,12,0,0" Style="{DynamicResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Margin="0,0,12,0"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Search titles, descriptions, tags, and subtasks" />
                                    <Button Grid.Column="1" Command="{Binding NewTaskCommand}"
                                            Content="New task" Style="{DynamicResource PrimaryButtonStyle}" />
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Margin="0,0,8,0" SelectedDate="{Binding FilterDueDate}" />
                                    <ComboBox Grid.Column="1" Margin="0,0,8,0"
                                              SelectedValue="{Binding SelectedPriorityFilter}"
                                              SelectedValuePath="Tag">
                                        <ComboBoxItem Content="Any priority" Tag="" />
                                        <ComboBoxItem Content="Low" Tag="low" />
                                        <ComboBoxItem Content="Medium" Tag="medium" />
                                        <ComboBoxItem Content="High" Tag="high" />
                                    </ComboBox>
                                    <ComboBox Grid.Column="2" Margin="0,0,8,0"
                                              SelectedValue="{Binding SelectedDifficultyFilter}"
                                              SelectedValuePath="Tag">
                                        <ComboBoxItem Content="Any difficulty" Tag="" />
                                        <ComboBoxItem Content="Unset" Tag="unset" />
                                        <ComboBoxItem Content="Easy" Tag="easy" />
                                        <ComboBoxItem Content="Medium" Tag="medium" />
                                        <ComboBoxItem Content="Hard" Tag="hard" />
                                    </ComboBox>
                                    <TextBox Grid.Column="3" Margin="0,0,8,0"
                                             Text="{Binding FilterTagsText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Comma-separated tags; all must match" />
                                    <Button Grid.Column="4" Margin="0,0,8,0"
                                            Command="{Binding ApplyFiltersCommand}"
                                            Content="Apply" Style="{DynamicResource SecondaryButtonStyle}" />
                                    <Button Grid.Column="5" Command="{Binding ClearFiltersCommand}"
                                            Content="Clear" Style="{DynamicResource SecondaryButtonStyle}" />
                                </Grid>

                                <Border Margin="0,0,0,14" Padding="12"
                                        Background="#20FF6B8A" BorderBrush="#70FF6B8A"
                                        BorderThickness="1" CornerRadius="8"
                                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Foreground="{DynamicResource ErrorBrush}" Text="{Binding ErrorMessage}" />
                                </Border>

                                <TextBlock Margin="4,24" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           Text="No tasks match the current filters."
                                           Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <ItemsControl ItemsSource="{Binding Tasks}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,9" Padding="12"
                                                    Background="{DynamicResource PanelAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Button Width="28" Height="28" Padding="0"
                                                            VerticalAlignment="Top"
                                                            Command="{Binding DataContext.ToggleTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{DynamicResource SecondaryButtonStyle}">
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Text" Value="✓" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>

                                                    <StackPanel Grid.Column="1" Margin="8,0,16,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Margin="0,2,8,0" FontSize="11"
                                                                       Foreground="{DynamicResource TextDimBrush}"
                                                                       Text="{Binding Id, StringFormat=\#{0}}" />
                                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Title}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextDimBrush}"
                                                                   Text="{Binding Description}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Description}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding Tags}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Margin="0,0,6,4" Padding="7,3"
                                                                            BorderBrush="#687C8CFF" BorderThickness="1"
                                                                            CornerRadius="10">
                                                                        <TextBlock FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                                                                   Text="{Binding}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding Subtasks}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Margin="0,0,0,3" Padding="4,3"
                                                                            HorizontalContentAlignment="Left"
                                                                            Background="Transparent" BorderThickness="0"
                                                                            Command="{Binding DataContext.ToggleSubtaskCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                            CommandParameter="{Binding}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Width="20">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text" Value="" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                                <Setter Property="Text" Value="✓" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <TextBlock Text="{Binding Title}" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <WrapPanel Margin="0,8,0,0">
                                                            <TextBlock Margin="0,0,12,0" FontSize="11"
                                                                       Foreground="{DynamicResource TextDimBrush}"
                                                                       Text="{Binding CreatedAt, StringFormat=Created {0:g}}" />
                                                            <TextBlock Margin="0,0,12,0" FontSize="11"
                                                                       Foreground="{DynamicResource TextDimBrush}"
                                                                       Text="{Binding DueDate, StringFormat=Due {0:MMM d, yyyy}}" />
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <Button Margin="0,0,0,6" Padding="9,5"
                                                                Command="{Binding DataContext.CyclePriorityCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                CommandParameter="{Binding}"
                                                                Content="{Binding Priority}"
                                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                                        <Border Margin="0,0,0,8" Padding="8,4" CornerRadius="10"
                                                                Background="#24FFBF4D">
                                                            <TextBlock HorizontalAlignment="Center" FontSize="11"
                                                                       Text="{Binding Difficulty, TargetNullValue=Unset}" />
                                                        </Border>
                                                        <Button Margin="0,0,0,6" Padding="9,5"
                                                                Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                CommandParameter="{Binding}" Content="Edit"
                                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                                        <Button Padding="9,5"
                                                                Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                CommandParameter="{Binding}" Content="Delete"
                                                                Style="{DynamicResource SecondaryButtonStyle}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <TabItem Header="Calendar">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{DynamicResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,12" Text="Calendar" Style="{DynamicResource SectionTitleStyle}" />
                                    <Calendar SelectedDate="{Binding SelectedCalendarDate}" />
                                    <Button Margin="0,14,0,0" Command="{Binding LoadCalendarDateCommand}"
                                            Content="Show tasks" Style="{DynamicResource PrimaryButtonStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Margin="0,0,0,12" Text="Tasks for selected date"
                                               Style="{DynamicResource SectionTitleStyle}" />
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding CalendarTasks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="11"
                                                        Background="{DynamicResource PanelAltBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                            <TextBlock Margin="0,4,0,0" FontSize="12"
                                                                       Foreground="{DynamicResource TextDimBrush}"
                                                                       Text="{Binding Description}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Text="{Binding Priority}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Grid.RowSpan="2" Background="#A811131D"
                                            Visibility="{Binding IsCalendarBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ProgressBar Width="180" Height="4" IsIndeterminate="True"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
            </Grid>
        </ScrollViewer>

        <Border Panel.ZIndex="50" Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border MaxWidth="620" MaxHeight="680" Margin="24" Style="{DynamicResource DialogCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorHeading}" Style="{DynamicResource SectionTitleStyle}" />
                        <TextBlock Margin="0,16,0,5" Foreground="{DynamicResource TextDimBrush}" Text="Title" />
                        <TextBox Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,12,0,5" Foreground="{DynamicResource TextDimBrush}" Text="Description" />
                        <TextBox MinHeight="76" AcceptsReturn="True" TextWrapping="Wrap"
                                 Text="{Binding DraftDescription, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,5" Foreground="{DynamicResource TextDimBrush}" Text="Due date" />
                                <DatePicker SelectedDate="{Binding DraftDueDate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,5" Foreground="{DynamicResource TextDimBrush}" Text="Priority" />
                                <ComboBox SelectedValue="{Binding DraftPriority}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Low" Tag="{x:Static enums:TaskPriority.Low}" />
                                    <ComboBoxItem Content="Medium" Tag="{x:Static enums:TaskPriority.Medium}" />
                                    <ComboBoxItem Content="High" Tag="{x:Static enums:TaskPriority.High}" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Margin="0,0,0,5" Foreground="{DynamicResource TextDimBrush}" Text="Difficulty" />
                                <ComboBox SelectedValue="{Binding DraftDifficulty}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Unset" Tag="{x:Null}" />
                                    <ComboBoxItem Content="Easy" Tag="{x:Static enums:TaskDifficulty.Easy}" />
                                    <ComboBoxItem Content="Medium" Tag="{x:Static enums:TaskDifficulty.Medium}" />
                                    <ComboBoxItem Content="Hard" Tag="{x:Static enums:TaskDifficulty.Hard}" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,12,0,5" Foreground="{DynamicResource TextDimBrush}"
                                   Text="Tags (comma-separated)" />
                        <TextBox Text="{Binding DraftTagsText, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Margin="0,16,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DraftDifficulty}" Value="{x:Static enums:TaskDifficulty.Hard}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid Margin="0,0,0,8">
                                <TextBlock VerticalAlignment="Center" Text="Subtasks" Style="{DynamicResource SectionTitleStyle}" />
                                <Button HorizontalAlignment="Right" Command="{Binding AddSubtaskCommand}"
                                        Content="Add subtask" Style="{DynamicResource SecondaryButtonStyle}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding DraftSubtasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Margin="0,0,8,0" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsCompleted}" />
                                            <TextBox Grid.Column="1" Margin="0,0,8,0"
                                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2"
                                                    Command="{Binding DataContext.RemoveSubtaskCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}" Content="Remove"
                                                    Style="{DynamicResource SecondaryButtonStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Margin="0,14,0,0" Padding="12" Background="#20FF6B8A"
                                BorderBrush="#70FF6B8A" BorderThickness="1" CornerRadius="8"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="{DynamicResource ErrorBrush}" Text="{Binding ErrorMessage}" />
                        </Border>

                        <StackPanel Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Margin="0,0,10,0" Command="{Binding CloseEditorCommand}"
                                    Content="Cancel" Style="{DynamicResource SecondaryButtonStyle}" />
                            <Button MinWidth="120" Command="{Binding SaveTaskCommand}"
                                    Content="Save task" Style="{DynamicResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</UserControl>
