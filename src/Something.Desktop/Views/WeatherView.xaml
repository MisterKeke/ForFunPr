<UserControl x:Class="Something.Desktop.Views.WeatherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="ForecastTemplate">
            <StackPanel>
                <Border Padding="16" Background="#2022D3EE" BorderBrush="#607C8CFF"
                        BorderThickness="1" CornerRadius="11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="0,0,14,0" VerticalAlignment="Center" FontSize="42"
                                   Text="{Binding Current.Icon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="30" FontWeight="Bold"
                                       Text="{Binding Current.Temperature, StringFormat={}{0:0}°}" />
                            <TextBlock Foreground="{DynamicResource TextDimBrush}"
                                       Text="{Binding Current.Condition}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource TextDimBrush}"
                                       Text="{Binding Current.ApparentTemperature, StringFormat=Feels like {0:0}°}" />
                            <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextDimBrush}"
                                       Text="{Binding Current.WindSpeed, StringFormat=Wind {0:0} km/h}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="166" Margin="0,0,8,8" Padding="11"
                                    Background="{DynamicResource PanelAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9">
                                <StackPanel>
                                    <TextBlock FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextDimBrush}" Text="{Binding DateLabel}" />
                                    <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                        <TextBlock Margin="0,0,7,0" FontSize="20" Text="{Binding Icon}" />
                                        <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding Condition}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding MaximumTemperature, StringFormat={}{0:0}°}" />
                                        <TextBlock Margin="7,0,0,0" Foreground="{DynamicResource TextDimBrush}"
                                                   Text="{Binding MinimumTemperature, StringFormat={}{0:0}°}" />
                                        <TextBlock Margin="12,0,0,0" Foreground="{DynamicResource TextDimBrush}"
                                                   Text="{Binding PrecipitationProbability, StringFormat={}{0:0}%}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="1120" Margin="0,0,24,24" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource PageTitleStyle}" />
                    <TextBlock Margin="0,7,0,0" Text="{Binding Subtitle}"
                               Style="{DynamicResource PageSubtitleStyle}" />
                </StackPanel>

                <Border Grid.Row="1" Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Saved coordinate forecast" Style="{DynamicResource SectionTitleStyle}" />
                                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextDimBrush}"
                                           Text="{Binding SavedLocationLabel}" />
                                <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                                           Text="{Binding SavedUpdatedLabel}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,6"
                                    Command="{Binding RefreshSavedCommand}" Content="Refresh"
                                    Style="{DynamicResource SecondaryButtonStyle}" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Margin="0,0,9,0" Text="{Binding LatitudeText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Latitude (-90 to 90)" />
                            <TextBox Grid.Column="1" Margin="0,0,9,0"
                                     Text="{Binding LongitudeText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Longitude (-180 to 180)" />
                            <Button Grid.Column="2" Command="{Binding LoadCoordinatesCommand}"
                                    Content="Save and load" Style="{DynamicResource PrimaryButtonStyle}" />
                        </Grid>
                        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource WarningBrush}"
                                   Text="{Binding StatusMessage}" />
                        <ContentControl Margin="0,14,0,0" Content="{Binding SavedForecast}"
                                        ContentTemplate="{StaticResource ForecastTemplate}" />
                        <TextBlock Margin="0,26" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextDimBrush}"
                                   Text="No cached forecast yet. Enter coordinates above.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSavedForecast}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Margin="0,14,0,0" Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Search a city" Style="{DynamicResource SectionTitleStyle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Margin="0,0,9,0" Text="{Binding CitySearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="City name" />
                            <Button Grid.Column="1" Command="{Binding SearchCityCommand}"
                                    Content="Search" Style="{DynamicResource PrimaryButtonStyle}" />
                        </Grid>
                        <TextBlock Margin="0,12,0,0" FontSize="16" FontWeight="SemiBold"
                                   Text="{Binding CityLocationLabel}" />
                        <ContentControl Margin="0,14,0,0" Content="{Binding CityForecast}"
                                        ContentTemplate="{StaticResource ForecastTemplate}" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Panel.ZIndex="30" Margin="24" Padding="12" VerticalAlignment="Top"
                Background="#E0201420" BorderBrush="#70FF6B8A" BorderThickness="1" CornerRadius="8"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
        </Border>
        <Border Panel.ZIndex="40" Background="#9811131D"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressBar Width="190" Height="4" IsIndeterminate="True"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
