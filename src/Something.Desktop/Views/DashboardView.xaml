<UserControl x:Class="Something.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="950">
    <UserControl.Resources>
        <DataTemplate x:Key="DashboardTaskTemplate">
            <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource PanelAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Width="28" Height="28" Padding="0" Content="&#xE73E;"
                            FontFamily="{DynamicResource IconFontFamily}"
                            Command="{Binding DataContext.ToggleTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                            CommandParameter="{Binding}"
                            Style="{DynamicResource SecondaryButtonStyle}" />
                    <StackPanel Grid.Column="1" Margin="10,0">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock Foreground="{DynamicResource TextDimBrush}" Text="{Binding DueDate}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"
                               Text="{Binding Priority}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <Grid x:Name="DashboardViewport" Margin="0,0,24,24">
        <Grid Width="{Binding ActualWidth, ElementName=DashboardViewport}"
              MaxWidth="1180" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="{Binding Title}" Style="{DynamicResource PageTitleStyle}" />
                <TextBlock Margin="0,7,0,0" Text="{Binding Subtitle}"
                           Style="{DynamicResource PageSubtitleStyle}" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,0,0,18" Style="{DynamicResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,12,0" VerticalAlignment="Center"
                                       Text="Today" FontSize="18" FontWeight="SemiBold" />
                            <Button Grid.Column="1" Content="All tasks"
                                    Command="{Binding OpenTasksCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}" />
                        </Grid>
                        <TextBlock Margin="0,0,0,10" Foreground="{DynamicResource TextDimBrush}"
                                   Text="{Binding TodayCountLabel}" />
                        <TextBlock Margin="0,16" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextDimBrush}"
                                   Text="No incomplete tasks due today.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TodayTasks.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding TodayTasks}" ItemTemplate="{StaticResource DashboardTaskTemplate}" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="{DynamicResource BorderBrush}" />

                    <StackPanel Grid.Column="4">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,12,0" VerticalAlignment="Center"
                                       Text="Calendar activity" FontSize="18" FontWeight="SemiBold" />
                            <Button Grid.Column="1" Content="Open calendar"
                                    Command="{Binding OpenTasksCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}" />
                        </Grid>
                        <TextBlock Margin="0,0,0,10" Foreground="{DynamicResource TextDimBrush}"
                                   Text="{Binding WeekCountLabel}" />
                        <TextBlock Margin="0,16" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextDimBrush}"
                                   Text="No more incomplete tasks due this week.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WeekTasks.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding WeekTasks}" ItemTemplate="{StaticResource DashboardTaskTemplate}" />
                    </StackPanel>
            </Grid>
            </Border>

            <Border Grid.Row="2" Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Favorite updates" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextDimBrush}"
                                       Text="{Binding LastRefreshedLabel}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Content="Telegram" Command="{Binding OpenTelegramCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}" />
                            <Button Margin="0,0,8,0" Content="YouTube" Command="{Binding OpenYouTubeCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}" />
                            <Button Content="Refresh" Command="{Binding RefreshFavoritesCommand}"
                                    Style="{DynamicResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,0,0,12" Padding="10" Background="#20FFB020"
                            BorderBrush="#70FFB020" BorderThickness="1" CornerRadius="8"
                            Visibility="{Binding HasPartialErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding PartialErrorMessage}" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Margin="0,22" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextDimBrush}"
                               Text="No new posts or videos in this update window.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFavoriteUpdates}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding FavoriteUpdates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="300" MinHeight="150" Margin="0,0,10,10" Padding="12"
                                        Background="{DynamicResource PanelAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="9">
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                                   Text="{Binding SourceLabel}" />
                                        <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Text="{Binding DisplayTitle}" />
                                        <TextBlock Margin="0,5,0,0" MaxHeight="54" Foreground="{DynamicResource TextDimBrush}"
                                                   Text="{Binding Preview}" TextWrapping="Wrap" />
                                        <Grid Margin="0,10,0,0">
                                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"
                                                       Text="{Binding PublishedLabel}" />
                                            <Button HorizontalAlignment="Right" Content="Open"
                                                    Command="{Binding DataContext.OpenUpdateCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource SecondaryButtonStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </ScrollViewer>

</UserControl>
