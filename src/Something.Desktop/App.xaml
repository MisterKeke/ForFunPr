<Application x:Class="Something.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Something.Desktop.ViewModels"
             xmlns:views="clr-namespace:Something.Desktop.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Buttons.xaml" />
                <ResourceDictionary Source="Themes/Inputs.xaml" />
                <ResourceDictionary Source="Themes/Lists.xaml" />
                <ResourceDictionary Source="Themes/Dialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}"><views:DashboardView /></DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:TasksViewModel}"><views:TasksView /></DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:NotesViewModel}"><views:NotesView /></DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:BookmarksViewModel}"><views:BookmarksView /></DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:TelegramViewModel}"><views:TelegramView /></DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:YouTubeViewModel}"><views:YouTubeView /></DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:WeatherViewModel}"><views:WeatherView /></DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:CurrenciesViewModel}"><views:CurrenciesView /></DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:FileExplorerViewModel}"><views:FileExplorerView /></DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:WallpapersViewModel}"><views:WallpapersView /></DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
