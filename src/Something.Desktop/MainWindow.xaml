<Window x:Class="Something.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Something"
        Width="1200"
        Height="760"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid ClipToBounds="True">
        <Border Background="{DynamicResource AppBackgroundBrush}" />
        <Image IsHitTestVisible="False" Source="{Binding WallpaperImage}" Stretch="UniformToFill" />
        <Border IsHitTestVisible="False" Background="#6A090B12" />
        <Ellipse Width="620" Height="620" Margin="-280,-340,0,0"
                 HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#4222D3EE" Offset="0" />
                    <GradientStop Color="#0022D3EE" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="560" Height="560" Margin="0,-320,-220,0"
                 HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#3DFF4FD8" Offset="0" />
                    <GradientStop Color="#00FF4FD8" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="18" Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontFamily="{DynamicResource DisplayFontFamily}"
                                   FontSize="24" FontWeight="Bold" Text="Something" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextDimBrush}"
                                   Text="Native desktop workspace" />
                    </StackPanel>

                    <Border Grid.Row="1" Height="1" Margin="0,18,0,14"
                            Background="{DynamicResource BorderBrush}" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding NavigationItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,7"
                                            AutomationProperties.Name="{Binding Label}"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            CommandParameter="{Binding PageKey}"
                                            Style="{DynamicResource NavigationButtonStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource IconFontFamily}"
                                                       FontSize="16"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                       Text="{Binding Glyph}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource DisplayFontFamily}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                       Text="{Binding Label}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="3" Margin="4,14,4,0"
                               Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                               Text="Development profile · Local-first" />
                </Grid>
            </Border>

            <ContentControl Grid.Column="2"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{Binding CurrentPage}" />
        </Grid>

        <ItemsControl Margin="0,24,24,0" HorizontalAlignment="Right"
                      VerticalAlignment="Top" Panel.ZIndex="20"
                      ItemsSource="{Binding Notifications}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="340" Margin="0,0,0,10" Padding="14"
                            Background="{DynamicResource PanelAltBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <TextBlock Text="{Binding}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Panel.ZIndex="30" Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="220" Height="5" IsIndeterminate="True" />
                <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextDimBrush}"
                           Text="Opening workspace…" />
            </StackPanel>
        </Border>

        <Border Panel.ZIndex="40" Background="{DynamicResource OverlayBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveDialog}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ContentControl Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Content="{Binding ActiveDialog}" />
        </Border>
    </Grid>
</Window>
